<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyTitle>LavOSC</AssemblyTitle>
    <Product>LavOSC</Product>
    <IsPackable>false</IsPackable>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationTitle>LavOSC</ApplicationTitle>
    <ApplicationId>com.laveyana.lavosc</ApplicationId>
    <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>Platforms/Windows/app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/AppIcon/lavosc.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.120" />
    <ProjectReference Include="../LavOSC.Core/LavOSC.Core.csproj" />
    <ProjectReference Include="../LavOSC.Modules.Wheel/LavOSC.Modules.Wheel.csproj" />
    <None Remove="Resources/AppIcon/lavosc.ico" />
    <Content Include="Resources/AppIcon/lavosc.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(WindowsPackageType)' == 'None'">
    <AssemblyMetadata Include="Microsoft.Maui.ApplicationModel.AppInfo.PackageName" Value="$(ApplicationId)" />
  </ItemGroup>
</Project>
